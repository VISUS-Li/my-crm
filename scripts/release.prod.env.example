# 复制为 scripts/release.prod.env 并填写真实值（已 gitignore）
# cp scripts/release.prod.env.example scripts/release.prod.env
#
# 生产机首次一键部署（在服务器上，代码已在 ~/crm-src）:
#   bash ~/crm-src/scripts/deploy-prod.sh init
#
# 仅刷新 Nginx / 证书:
#   bash ~/crm-src/scripts/deploy-prod.sh nginx
#
# Windows 日常发版（本机）:
#   python scripts/sync_to_server.py --deploy

# ── 服务器 & 域名 ─────────────────────────────────────────────────────
DOMAIN=crm.zccmz.cn
SERVER_URL=https://crm.zccmz.cn
CERTBOT_EMAIL=admin@zccmz.cn

# Frappe 站点名必须与浏览器访问的主机名一致（Socket.IO 校验）
SITE_NAME=crm.zccmz.cn

# 内网端口（仅本机 + Nginx 反代，勿在安全组对外开放）
WEB_PORT=8010
SOCKETIO_PORT=9010

# 部署目录
PROD_DIR=/opt/crm
CRM_SRC=/root/crm-src
BENCH_DIR=/root/frappe-bench

# ── 数据库（MariaDB Docker 容器，见 deploy/docker-compose.prod.yml）──
DB_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307

# ── Frappe 管理员 ─────────────────────────────────────────────────────
ADMIN_PASSWORD=

# ── 证书（国内阿里云 ECS 推荐 acme-dns-ali 或 manual）────────────────
#   acme-dns-ali  - acme.sh + 阿里云 DNS 验证（域名 DNS 须在阿里云）
#   acme-webroot  - acme.sh HTTP-01（需 80 端口、DNS 已指向本机）
#   certbot       - Let's Encrypt + certbot（境外网络友好）
#   manual        - 阿里云控制台免费 DV 证书 + import-aliyun-cert.sh
CERT_PROVIDER=acme-dns-ali

# acme-dns-ali 必填（RAM 用户仅需 Aliyun DNS 管理权限）
# ALIYUN_ACCESS_KEY_ID=LTAI...
# ALIYUN_ACCESS_KEY_SECRET=...

# manual 流程:
#   1. 阿里云 SSL -> 免费证书 -> 下载 Nginx
#   2. CERT_PROVIDER=manual
#   3. bash scripts/import-aliyun-cert.sh crm.zccmz.cn privkey.pem fullchain.pem
#   4. bash scripts/deploy-prod.sh nginx

# ACME_SERVERS=zerossl,letsencrypt
# CERTBOT_HTTPS_PROXY=http://127.0.0.1:7890

# ── 可选 ──────────────────────────────────────────────────────────────
# ENABLE_SWAP=true
# SWAP_SIZE_GB=2
# DEVELOPER_MODE=0
