# 复制为 scripts/release.env 并填写真实值（build + deploy 共用，已 gitignore）
# cp scripts/release.env.example scripts/release.env
#
# 构建机: ./scripts/build.sh [version]
# 生产机: ./scripts/deploy.sh init [version]

# ── 域名 ────────────────────────────────────────────────────────────────
DOMAIN=crm.zccmz.cn
SITE_NAME=crm.zccmz.cn
SERVER_URL=https://crm.zccmz.cn
CERTBOT_EMAIL=admin@zccmz.cn

# ── 47.95.2.50：复用已有宿主机 Nginx（与 aizhibo/zhongchi 相同模式）────
# 容器绑定 127.0.0.1:8000 / :9000，Nginx 写 /etc/nginx/conf.d/crm.conf
HOST_NGINX=true
HOST_NGINX_CONF=/etc/nginx/conf.d/crm.conf
ENABLE_NGINX=false
APP_PUBLISH_HOST=127.0.0.1
APP_PUBLISH_PORT=8000
SOCKETIO_PUBLISH_PORT=9000

# 若全新机器、无宿主机 Nginx，改为:
# HOST_NGINX=false
# ENABLE_NGINX=true
# CERT_PROVIDER=acme-dns-ali

CERT_PROVIDER=certbot

# ── TripAI（CRM 容器内通过环境变量读取，见 crm/integrations/tripai/settings.py）
# aizhibo.icu 在 47.108.50.28，与 CRM 服务器不同机，走公网 HTTPS 即可
TRIPAI_BASE_URL=https://aizhibo.icu
TRIPAI_PROJECT_KEY=nextdevtpl
TRIPAI_TOOL_KEY=my-crm
# TRIPAI_RUNTIME_TOKEN=   # 可选，也可在 CRM TripAI Settings DocType 中配置

# ── 阿里云镜像仓库 ────────────────────────────────────────────────────
REGISTRY_DOMAIN=crpi-dwpdx29dne1d4tyy.cn-chengdu.personal.cr.aliyuncs.com
REGISTRY_USER=1183989659@qq.com
REGISTRY_PASSWORD=Docker4250
NAMESPACE=visus
IMAGE_NAME=my-crm

# ── 生产目录 ──────────────────────────────────────────────────────────
PROD_DIR=/opt/crm

# ── 数据库 & 管理员（deploy.sh init 时若为空则自动生成）──────────────
# DB_ROOT_PASSWORD=
# ADMIN_PASSWORD=
DEVELOPER_MODE=0

# ── 可选 ──────────────────────────────────────────────────────────────
ENABLE_SWAP=true
SWAP_SIZE_GB=6
# SKIP_LOGIN=true
# SKIP_PUSH=true
# SKIP_PULL=true
