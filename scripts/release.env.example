# 复制为 scripts/release.env 并填写真实值（build + deploy 共用，已 gitignore）
# cp scripts/release.env.example scripts/release.env
#
# 构建机（Windows WSL / Linux / macOS）:
#   ./scripts/build.sh [version]
#
# 生产机首次:
#   ./scripts/deploy.sh init [version]
#
# 生产机发版:
#   ./scripts/deploy.sh app [version]

# ── 域名 HTTPS 部署（推荐）────────────────────────────────────────────
DOMAIN=crm.zccmz.cn
SITE_NAME=crm.zccmz.cn
SERVER_URL=https://crm.zccmz.cn
CERTBOT_EMAIL=admin@zccmz.cn
# WWW_DOMAIN=www.crm.zccmz.cn

# 证书方案（国内 ECS 推荐）:
#   acme-dns-ali  - acme.sh + 阿里云 DNS 验证（域名 DNS 须在阿里云）
#   manual        - 阿里云控制台免费 DV + import-aliyun-cert.sh（最稳）
#   acme-webroot  - acme.sh HTTP-01（需 80 端口）
#   certbot       - Let's Encrypt + certbot（境外网络友好）
CERT_PROVIDER=acme-dns-ali

# acme-dns-ali 必填
# ALIYUN_ACCESS_KEY_ID=LTAI...
# ALIYUN_ACCESS_KEY_SECRET=...

# manual 流程:
#   1. 阿里云 SSL -> 免费证书 -> 下载 Nginx
#   2. CERT_PROVIDER=manual
#   3. ./scripts/import-aliyun-cert.sh crm.zccmz.cn key.pem cert.pem
#   4. ./scripts/deploy.sh nginx

# ENABLE_NGINX=false   # 仅 IP:8000 访问时可关闭 Nginx

# ── 阿里云镜像仓库（build.sh push / deploy.sh pull）──────────────────
REGISTRY_DOMAIN=crpi-dwpdx29dne1d4tyy.cn-chengdu.personal.cr.aliyuncs.com
REGISTRY_USER=your_registry_username
REGISTRY_PASSWORD=your_registry_password
NAMESPACE=visus
IMAGE_NAME=my-crm

# ── 生产部署目录 ──────────────────────────────────────────────────────
PROD_DIR=/opt/crm
APP_PUBLISH_PORT=8000
SOCKETIO_PUBLISH_PORT=9000

# ── 数据库 & 管理员（deploy.sh init 时若为空则自动生成）──────────────
# DB_ROOT_PASSWORD=
# ADMIN_PASSWORD=
DEVELOPER_MODE=0

# ── 可选 ──────────────────────────────────────────────────────────────
# ENABLE_SWAP=true
# SWAP_SIZE_GB=2
# SKIP_LOGIN=true
# SKIP_PUSH=true
# SKIP_PULL=true
# KEEP_DB_VOLUME=true
